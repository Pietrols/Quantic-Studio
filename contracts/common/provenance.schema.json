{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantic-studio:contracts:0.1.0:common:provenance",
  "title": "Provenance",
  "description": "Origin and reproducibility metadata for a solver result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["solver_name", "solver_version", "input_hash_sha256", "timestamp"],
  "properties": {
    "solver_name": { "type": "string", "minLength": 1 },
    "solver_version": { "type": "string", "minLength": 1 },
    "input_hash_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
