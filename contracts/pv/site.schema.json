{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantic-studio:contracts:0.1.0:pv:site",
  "title": "PVSite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "name",
    "latitude_deg",
    "longitude_deg",
    "elevation_m",
    "orientation_convention",
    "albedo",
    "modules",
    "inverters",
    "arrays",
    "losses"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "latitude_deg": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude_deg": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "elevation_m": {
      "type": "number"
    },
    "orientation_convention": {
      "const": "north_clockwise_tilt_from_horizontal"
    },
    "albedo": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_id",
          "reference_dc_power_w",
          "reference_cell_temperature_c",
          "power_temperature_coefficient_per_k",
          "temperature"
        ],
        "properties": {
          "module_id": {
            "type": "string",
            "minLength": 1
          },
          "reference_dc_power_w": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reference_cell_temperature_c": {
            "type": "number"
          },
          "power_temperature_coefficient_per_k": {
            "type": "number"
          },
          "temperature": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model",
                  "noct_c"
                ],
                "properties": {
                  "model": {
                    "const": "ross"
                  },
                  "noct_c": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model"
                ],
                "properties": {
                  "model": {
                    "const": "supplied_cell"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "inverters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inverter_id",
          "dc_input_limit_w",
          "ac_rating_w",
          "nominal_efficiency",
          "reference_efficiency"
        ],
        "properties": {
          "inverter_id": {
            "type": "string",
            "minLength": 1
          },
          "dc_input_limit_w": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ac_rating_w": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "nominal_efficiency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "exclusiveMinimum": 0
          },
          "reference_efficiency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "arrays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "array_id",
          "mount",
          "tilt_deg",
          "azimuth_deg",
          "module_id",
          "module_count",
          "inverter_id"
        ],
        "properties": {
          "array_id": {
            "type": "string",
            "minLength": 1
          },
          "mount": {
            "const": "fixed_tilt"
          },
          "tilt_deg": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
          },
          "azimuth_deg": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          },
          "module_id": {
            "type": "string",
            "minLength": 1
          },
          "module_count": {
            "type": "integer",
            "minimum": 1
          },
          "inverter_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "losses": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "loss_id",
          "name",
          "stage",
          "fraction"
        ],
        "properties": {
          "loss_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "irradiance",
              "dc",
              "ac"
            ]
          },
          "fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
