{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantic-studio:contracts:0.3.0:power:shortcircuit-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "network_id",
    "fault_type",
    "fault_duration_s",
    "frequency_hz",
    "lv_tolerance_percent",
    "status",
    "case_results",
    "assumptions",
    "diagnostics",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "network_id": {
      "type": "string",
      "minLength": 1
    },
    "fault_type": {
      "const": "3ph"
    },
    "fault_duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "frequency_hz": {
      "enum": [
        50,
        60
      ]
    },
    "lv_tolerance_percent": {
      "enum": [
        6,
        10
      ]
    },
    "status": {
      "enum": [
        "success",
        "partial",
        "failed"
      ]
    },
    "case_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case",
          "status",
          "bus_results",
          "diagnostics"
        ],
        "properties": {
          "case": {
            "enum": [
              "max",
              "min"
            ]
          },
          "status": {
            "enum": [
              "success",
              "partial",
              "failed"
            ]
          },
          "bus_results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bus_id",
                "voltage_factor",
                "ikss_ka",
                "ip_ka",
                "ith_ka"
              ],
              "properties": {
                "bus_id": {
                  "type": "string",
                  "minLength": 1
                },
                "voltage_factor": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0
                },
                "ikss_ka": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "ip_ka": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "ith_ka": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "trace": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "un_kv",
                    "voltage_factor",
                    "source_voltage_kv",
                    "impedance_basis",
                    "elements",
                    "zk_r_ohm",
                    "zk_x_ohm",
                    "zk_ohm",
                    "rx_ratio",
                    "kappa",
                    "kappa_method",
                    "m",
                    "n"
                  ],
                  "properties": {
                    "un_kv": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "voltage_factor": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "source_voltage_kv": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "impedance_basis": {
                      "enum": [
                        "radial-sum",
                        "engine-thevenin"
                      ]
                    },
                    "elements": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "element_type",
                          "element_id",
                          "inputs",
                          "r_ohm",
                          "x_ohm",
                          "referral_factor",
                          "r_referred_ohm",
                          "x_referred_ohm"
                        ],
                        "properties": {
                          "element_type": {
                            "enum": [
                              "external_grids",
                              "generators",
                              "transformers",
                              "lines"
                            ]
                          },
                          "element_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "inputs": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "number"
                            }
                          },
                          "r_ohm": {
                            "type": "number",
                            "minimum": 0
                          },
                          "x_ohm": {
                            "type": "number"
                          },
                          "referral_factor": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "r_referred_ohm": {
                            "type": "number",
                            "minimum": 0
                          },
                          "x_referred_ohm": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    "zk_r_ohm": {
                      "type": "number",
                      "minimum": 0
                    },
                    "zk_x_ohm": {
                      "type": "number"
                    },
                    "zk_ohm": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "rx_ratio": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "kappa": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 1,
                      "maximum": 2
                    },
                    "kappa_method": {
                      "enum": [
                        "radial",
                        "method-C",
                        null
                      ]
                    },
                    "m": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "n": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "exclusiveMinimum": 0
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "ikss_ka": {
                        "type": "null"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "ip_ka": {
                        "type": "null"
                      },
                      "ith_ka": {
                        "type": "null"
                      },
                      "trace": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "urn:quantic-studio:contracts:0.1.0:common:diagnostic"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "success"
                }
              }
            },
            "then": {
              "properties": {
                "bus_results": {
                  "items": {
                    "properties": {
                      "voltage_factor": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "ikss_ka": {
                        "type": "number",
                        "minimum": 0
                      },
                      "ip_ka": {
                        "type": "number",
                        "minimum": 0
                      },
                      "ith_ka": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "properties": {
                "bus_results": {
                  "items": {
                    "properties": {
                      "ikss_ka": {
                        "type": "null"
                      },
                      "ip_ka": {
                        "type": "null"
                      },
                      "ith_ka": {
                        "type": "null"
                      }
                    }
                  }
                },
                "diagnostics": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "partial"
                }
              }
            },
            "then": {
              "properties": {
                "bus_results": {
                  "contains": {
                    "properties": {
                      "ikss_ka": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                },
                "diagnostics": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "urn:quantic-studio:contracts:0.1.0:common:diagnostic"
      }
    },
    "provenance": {
      "$ref": "urn:quantic-studio:contracts:0.1.0:common:provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "case_results": {
            "items": {
              "properties": {
                "status": {
                  "const": "success"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "case_results": {
            "items": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            }
          }
        }
      }
    }
  ]
}
