{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantic-studio:contracts:0.2.0:power:shortcircuit-request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "network_file",
    "fault_type",
    "cases",
    "fault_duration_s",
    "frequency_hz",
    "lv_tolerance_percent"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "network_file": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "fault_type": {
      "const": "3ph"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "max",
          "min"
        ]
      }
    },
    "fault_duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "frequency_hz": {
      "enum": [
        50,
        60
      ]
    },
    "lv_tolerance_percent": {
      "enum": [
        6,
        10
      ]
    }
  }
}
