{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantic-studio:contracts:1.0.0:project:manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "model_type": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "model_id",
          "model_type",
          "file"
        ]
      }
    },
    "studies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "study_id": {
            "type": "string",
            "minLength": 1
          },
          "study_type": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "request_file": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "study_id",
          "study_type",
          "model_id",
          "request_file"
        ]
      }
    },
    "asset_registry": {
      "$ref": "urn:quantic-studio:contracts:1.0.0:project:asset-registry"
    }
  },
  "required": [
    "schema_version",
    "name",
    "models",
    "studies",
    "asset_registry"
  ]
}
