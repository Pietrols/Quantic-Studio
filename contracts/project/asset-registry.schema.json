{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantic-studio:contracts:1.0.0:project:asset-registry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "representations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model_id": {
                  "type": "string",
                  "minLength": 1
                },
                "element_type": {
                  "type": "string",
                  "minLength": 1
                },
                "element_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "model_id",
                "element_type",
                "element_id"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "asset_id",
          "representations"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "assets"
  ]
}
