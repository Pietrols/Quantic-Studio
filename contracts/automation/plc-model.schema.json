{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantic-studio:contracts:0.1.0:automation:plc-model",
  "title": "PlcModel",
  "description": "CC-6 controller model. Declarations are structured data; program.body holds only Structured Text statements of the quantic-st-0.1 subset (docs/specs/structured-text-subset.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "controller_id",
    "name",
    "language",
    "program",
    "variables",
    "instances",
    "task",
    "devices",
    "process"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "controller_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^.]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "quantic-st-0.1"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_id",
        "body"
      ],
      "properties": {
        "program_id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 64
        },
        "body": {
          "type": "string",
          "maxLength": 65536
        }
      }
    },
    "variables": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "section",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 64
          },
          "section": {
            "enum": [
              "input",
              "output",
              "internal"
            ]
          },
          "type": {
            "enum": [
              "BOOL",
              "INT",
              "REAL",
              "TIME"
            ]
          },
          "initial": {
            "type": [
              "boolean",
              "integer",
              "number"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "instances": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "block"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 64
          },
          "block": {
            "enum": [
              "TON",
              "TOF",
              "TP",
              "CTU",
              "CTD",
              "CTUD"
            ]
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "kind",
        "period_ms"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^.]+$"
        },
        "kind": {
          "const": "cyclic"
        },
        "period_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "devices": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device_id",
          "label",
          "io"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^.]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "io": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "maxLength": 64
            }
          }
        }
      }
    },
    "process": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "process_id",
            "kind",
            "wiring",
            "initial"
          ],
          "properties": {
            "process_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^.]+$"
            },
            "kind": {
              "const": "motor_starter"
            },
            "wiring": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "coil",
                "contactor_feedback",
                "overload_ok"
              ],
              "properties": {
                "coil": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "maxLength": 64
                },
                "contactor_feedback": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "maxLength": 64
                },
                "overload_ok": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "maxLength": 64
                }
              }
            },
            "initial": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contactor_closed",
                "overload_tripped"
              ],
              "properties": {
                "contactor_closed": {
                  "type": "boolean"
                },
                "overload_tripped": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      ]
    }
  }
}
